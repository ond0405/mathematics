---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sidebar from "../components/Sidebar.astro";

// titleにLayout.astroをimportした各ページから受け取ったtitleの値を代入。受け取るものがない場合はデフォルトで小学算数徹底攻略
const { title = "保護者の味方のおうち算数" } = Astro.props;
---

<html lang="ja">
  <head>
    <!-- Googleアナリティクスを動かすのに必要なコード -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5FVDM7DJ78"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-5FVDM7DJ78");
    </script>
    <!-- 文字コード設定 -->
    <meta charset="utf-8" />
    <!-- ブラウザのタブに表示されるアイコン設定 -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <!-- 機種によらないフォント統一 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <!-- スマホサイズに対応する設定 -->
    <meta name="viewport" content="width=device-width" />
    <!-- Astroが初期作成してくれたファイルである証拠 -->
    <meta name="generator" content={Astro.generator} />
    <!-- ブラウザのタブに表示されるタイトルであり、検索時に表示されるタイトルの設定 -->
    <!-- {title}は上記に定義された値 -->
    <title>{title}</title>
  </head>

  <body>
    <!-- Header.astroをimportしたためHeaderタグを使えるようになり、Header.astroの中身がそのまま反映される -->
    <Header />

    <!-- サイドバーとメインをdivで囲むことで、其の2つを横並びにするcssをつける -->
    <div class="layout-container">
      <!-- Sidebar.astroをimportしたためSidebarタグを使えるようになり、Sidebar.astroの中身がそのまま反映される -->
      <Sidebar />

      <!-- メインコンテンツ 上下左右に2remのパディング、中身がスカスカでも画面縦幅の60%分はメインコンテンツ用の縦幅用意 -->
      <!-- slotにはLayoutをimportした各ページの中身が入る -->
      <main style="padding: 2rem; min-height: 60vh;">
        <slot />
      </main>
    </div>

    <!-- Footer.astroをimportしたためFooterタグを使えるようになり、Footer.astroの中身がそのまま反映される -->
    <Footer />
  </body>
</html>

<style>
  .layout-container {
    display: grid; /* Sidebarとmainが格子状のレイアウトになるように */
    grid-template-columns: 240px 1fr; /* 左のSidebarが固定240px、右のmainが残り全幅 */
  }

  /* スマホ用の設定（画面幅が 600px 以下のとき） */
  @media (max-width: 600px) {
    .layout-container {
      grid-template-columns: 1fr; /* サイドバーを上に乗せる */
    }
  }
</style>

<!-- Layout.astroをimportする全てのファイルに適用する -->
<style is:global>
  main {
    background-color: rgba(127, 255, 146, 0.463);
  }
  /* bodyタグにデフォルトでついているmargin 8pxを消す */
  body {
    margin: 0;
    font-family: "Zen Maru Gothic", sans-serif;
  }
</style>
